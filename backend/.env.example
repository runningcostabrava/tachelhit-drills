# Database
DATABASE_URL=sqlite:///drills.db

# API key protecting all mutating endpoints (POST/PUT/DELETE/PATCH).
# When set, requests must send the same value in an X-API-Key header
# (set VITE_API_KEY to the same value on the frontend). Leave empty to
# keep the API open (local development).
API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Pexels API (for image generation)
PEXELS_API_KEY=your_pexels_api_key_here

# HuggingFace Space for video generation (optional)
HUGGINGFACE_SPACE_URL=https://josepabloucr-tachelhit-video-generator.hf.space

# HuggingFace Space for burned-in subtitle OCR (optional; deploy
# huggingface-ocr-space/ and put its URL here to enable /video-analysis/ocr)
HUGGINGFACE_OCR_SPACE_URL=

# Cloudinary (for cloud media storage - optional, falls back to local storage if not set)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# YouTube Cookies (Netscape format string or path to cookies.txt)
# Needed to avoid "Sign in to confirm you're not a bot" errors on servers like Render
YOUTUBE_COOKIES=
