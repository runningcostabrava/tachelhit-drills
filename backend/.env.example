# Database
DATABASE_URL=sqlite:///drills.db

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Pexels API (for image generation)
PEXELS_API_KEY=your_pexels_api_key_here

# HuggingFace Space for video generation (optional)
HUGGINGFACE_SPACE_URL=https://josepabloucr-tachelhit-video-generator.hf.space

# Cloudinary (for cloud media storage - optional, falls back to local storage if not set)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# YouTube Cookies (Netscape format string or path to cookies.txt)
# Needed to avoid "Sign in to confirm you're not a bot" errors on servers like Render
YOUTUBE_COOKIES=
