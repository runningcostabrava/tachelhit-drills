# Development environment (local backend)
VITE_API_URL=http://localhost:8000

# Production environment (deployed backend)
# VITE_API_URL=https://tachelhit-drills-api.onrender.com

# To switch between environments, copy this file to .env and adjust VITE_API_URL.

# API key sent as X-API-Key on every backend request. Must match the
# backend's API_KEY env var. Leave unset while the backend key is unset.
# NOTE: like all VITE_ vars this is baked into the client bundle - it keeps
# bots/strangers out but is visible to anyone who has access to the app.
# VITE_API_KEY=
